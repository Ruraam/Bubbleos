#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
    SOURCE="$(readlink -- "$SOURCE")"
    [[ "$SOURCE" == /* ]] || SOURCE="${SOURCE_DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
BUBBLE_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
REPO_DIR="$(cd -- "${BUBBLE_DIR}/.." && pwd)"

# Prefer an installed configuration, then use the repository configuration.
if [[ -r /etc/bubbleos/bubble.conf ]]; then
    # shellcheck disable=SC1091
    source /etc/bubbleos/bubble.conf
elif [[ -r "${REPO_DIR}/config/bubble.conf" ]]; then
    # shellcheck disable=SC1091
    source "${REPO_DIR}/config/bubble.conf"
fi

# In a source checkout, fall back to the vendored ULPM tree.
if [[ ! -r "${BUBBLEOS_ULPM_DIR:-}/bin/ulpm" && -r "${REPO_DIR}/ulpm/bin/ulpm" ]]; then
    BUBBLEOS_ULPM_DIR="${REPO_DIR}/ulpm"
fi

# shellcheck disable=SC1091
source "${BUBBLE_DIR}/lib/paths.sh"
# shellcheck disable=SC1091
source "${BUBBLE_DIR}/lib/generation.sh"
# shellcheck disable=SC1091
source "${BUBBLE_DIR}/lib/system.sh"
# shellcheck disable=SC1091
source "${BUBBLE_DIR}/lib/bootloader.sh"

usage() {
    cat <<'USAGE'
Usage: bubble <command>

Commands:
  bootstrap       Initialize the bubbleOS state template (build time)
  boot            Record the active generation at boot (internal)
  status          Show bubbleOS system status
  generations     List system generations
  generation list                 List system generations
  generation create [options]     Clone the current generation
      --from <gen>                Source generation (default: current)
      --description <text>        Generation description
  generation activate <gen>       Select a generation for the next boot
  generation current              Print the selected generation
  snapshots       List read-only restore points
  snapshots prune [--keep N] [--dry-run]
                  Remove old automatic snapshots (initial points are kept)
  snapshots restore <name>
                  Restore /var from a snapshot on the next boot
  rollback        Select the previous generation for the next boot
  bootloader sync Regenerate the Limine boot menu from the generations
  help            Show this help

Generations are Btrfs subvolumes under @rootfs/generations.
The package-driven system installer is not implemented yet.
USAGE
}

cmd="${1:-help}"
case "$cmd" in
    bootstrap)
        bubble_system_bootstrap
        ;;
    boot)
        bubble_system_boot
        ;;
    status)
        bubble_system_status
        ;;
    generations)
        bubble_generation_list
        ;;
    generation)
        action="${2:-list}"
        case "$action" in
            list)
                bubble_generation_list
                ;;
            current)
                bubble_generation_current
                ;;
            create)
                shift 2
                gen="$(bubble_generation_create "$@")"
                printf 'Created generation %s\n' "$gen"
                bubble_bootloader_sync || true
                ;;
            activate)
                if [[ $# -ne 3 ]]; then
                    printf 'bubble: generation activate requires exactly one generation number\n\n' >&2
                    usage >&2
                    exit 2
                fi
                bubble_generation_activate "$3"
                bubble_bootloader_sync || true
                printf 'Activated generation %s (reboot required)\n' "$3"
                ;;
            help|-h|--help)
                usage
                ;;
            *)
                printf 'bubble: unknown generation command: %s\n\n' "$action" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    snapshots)
        action="${2:-list}"
        case "$action" in
            list)
                bubble_snapshot_list
                ;;
            prune)
                shift 2
                bubble_snapshot_prune "$@"
                ;;
            restore)
                if [[ "${3:-}" == "--apply" ]]; then
                    bubble_var_restore_apply
                else
                    if [[ $# -ne 3 ]]; then
                        printf 'bubble: snapshots restore requires exactly one snapshot name\n\n' >&2
                        usage >&2
                        exit 2
                    fi
                    bubble_var_restore_schedule "$3"
                fi
                ;;
            help|-h|--help)
                usage
                ;;
            *)
                printf 'bubble: unknown snapshots command: %s\n\n' "$action" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    rollback)
        bubble_require_root
        previous="$(bubble_generation_previous)" || {
            printf 'bubble: no previous generation available\n' >&2
            exit 1
        }
        bubble_generation_activate "$previous"
        bubble_bootloader_sync || true
        printf 'Activated generation %s (reboot required)\n' "$previous"
        ;;
    bootloader)
        action="${2:-sync}"
        case "$action" in
            sync)
                bubble_require_root
                bubble_bootloader_sync
                ;;
            help|-h|--help)
                usage
                ;;
            *)
                printf 'bubble: unknown bootloader command: %s\n\n' "$action" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'bubble: unknown command: %s\n\n' "$cmd" >&2
        usage >&2
        exit 2
        ;;
esac
