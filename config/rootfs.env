# bubbleOS RootFS identity
#
# The RootFS is a Btrfs filesystem identified by a stable filesystem UUID
# instead of a kernel device name. The same image is booted both as a
# partitioned disk (/dev/vda3) and directly as a bare image (/dev/vda), so the
# filesystem UUID is the only identifier that works in both modes.
#
# PARTUUID is also fixed for the GPT partition, but BusyBox findfs in the
# initramfs resolves UUID= and LABEL= only. The GPT partition UUID is kept for
# partitioning tools and future boot paths.
#
# The values are fixed for reproducible development images. A production
# installer must generate a unique UUID per installation.
ROOTFS_LABEL="${ROOTFS_LABEL:-bubbleos-root}"
ROOTFS_UUID="${ROOTFS_UUID:-b0bb1e05-4a2d-4f00-9000-000000000001}"
ROOTFS_PARTUUID="${ROOTFS_PARTUUID:-b0bb1e05-4a2d-4f00-9000-000000000002}"

# The EFI System Partition volume ID is fixed so /etc/fstab can mount /boot by
# UUID and `bubble bootloader sync` can rewrite the Limine menu. mkfs.vfat
# expects the raw eight-digit form; blkid and fstab use the XXXX-XXXX form.
ESP_UUID="${ESP_UUID:-B0BB-1E05}"
ESP_VOLUME_ID="${ESP_VOLUME_ID:-${ESP_UUID//-/}}"
